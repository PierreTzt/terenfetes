// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EventStatus {
  PENDING
  PUBLISHED
  REJECTED
  ARCHIVED
}

enum SourceKind {
  RSS
  ICS
  HTML
  FB
  FORM
}

enum SubscriptionTier {
  FREE
  PRO
}

model Event {
  id            String         @id @default(uuid())
  title         String
  slug          String         @unique
  description   String?
  startAt       DateTime
  endAt         DateTime?
  venue         Venue?         @relation(fields: [venueId], references: [id])
  venueId       String?
  address       String?
  city          String?
  lat           Float?
  lng           Float?
  priceMin      Decimal?
  priceMax      Decimal?
  category      String[]
  audience      String[]
  imageUrl      String?
  source        Source?        @relation(fields: [sourceId], references: [id])
  sourceId      String?
  sourceUid     String?        @unique
  status        EventStatus    @default(PENDING)
  accessibility Json?
  tags          String[]
  url           String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  metrics       MetricsEvent[]

  // Monetization fields
  isSponsored      Boolean    @default(false)
  sponsoredUntil   DateTime?
  organizer        Organizer? @relation(fields: [organizerId], references: [id])
  organizerId      String?
  moderationReason String?
  moderatedAt      DateTime?

  // Content & badges
  badges            String[] @default([])
  duration          Int? // Duration in minutes
  indoor            Boolean? // Indoor/Outdoor
  pmr               Boolean  @default(false) // Accessible PMR
  weatherDependent  Boolean  @default(false)
  capacityTotal     Int?
  capacityRemaining Int?

  // Relations
  passportCheckins UserPassport[]
  favorites        Favorite[]
  reminders        Reminder[]
  photos           Photo[]
  listItems        ListItem[]
  similarities     EventSimilarity[] @relation("EventToSimilar")
  similarTo        EventSimilarity[] @relation("SimilarToEvent")

  @@index([startAt])
  @@index([city])
  @@index([status])
  @@index([isSponsored])
  @@index([organizerId])
  @@index([createdAt])
}

model Venue {
  id      String  @id @default(uuid())
  name    String
  address String?
  city    String?
  lat     Float?
  lng     Float?
  url     String?
  phone   String?
  email   String?
  events  Event[]

  @@unique([name, city])
  @@index([city])
  @@index([lat, lng])
}

model Source {
  id        String     @id @default(uuid())
  kind      SourceKind
  name      String
  url       String?
  parser    Json?
  active    Boolean    @default(true)
  lastRunAt DateTime?
  events    Event[]

  @@index([kind, active])
}

model MetricsEvent {
  id          String   @id @default(uuid())
  eventId     String
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  metricDate  DateTime @default(now())
  views       Int      @default(0)
  clicksCta   Int      @default(0)
  rsvpIntent  Int      @default(0)
  ticketsSold Int      @default(0)
  revenue     Decimal?

  @@index([eventId, metricDate])
}

model Newsletter {
  id          String    @id @default(uuid())
  subject     String
  content     String
  sentAt      DateTime?
  scheduledAt DateTime?
  status      String    @default("draft")
  openRate    Float?
  clickRate   Float?
  createdAt   DateTime  @default(now())
}

model Subscriber {
  id               String   @id @default(uuid())
  email            String   @unique
  confirmed        Boolean  @default(false)
  confirmToken     String?  @unique
  unsubscribed     Boolean  @default(false)
  unsubscribeToken String?  @unique
  city             String?
  categories       String[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([email])
  @@index([confirmed, unsubscribed])
}

// Monetization models

model Organizer {
  id                String           @id @default(uuid())
  email             String           @unique
  name              String
  description       String?
  logo              String?
  website           String?
  phone             String?
  verified          Boolean          @default(false)
  subscriptionTier  SubscriptionTier @default(FREE)
  featuredThisMonth Boolean          @default(false)
  featuredDate      DateTime?
  events            Event[]
  subscriptions     Subscription[]
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([email])
  @@index([verified])
  @@index([subscriptionTier])
}

model Subscription {
  id          String           @id @default(uuid())
  organizer   Organizer        @relation(fields: [organizerId], references: [id], onDelete: Cascade)
  organizerId String
  tier        SubscriptionTier
  startDate   DateTime         @default(now())
  endDate     DateTime?
  stripeId    String?          @unique
  status      String           @default("active") // active, cancelled, expired
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([organizerId])
  @@index([status])
}

model Partner {
  id             String   @id @default(uuid())
  name           String
  description    String?
  logo           String?
  address        String?
  city           String?
  category       String[]
  offer          String // Description of the offer
  stampsRequired Int      @default(5) // Number of stamps required
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([city])
  @@index([active])
}

model UserPassport {
  id          String   @id @default(uuid())
  userId      String // Can be email or session ID for anonymous users
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId     String
  checkInDate DateTime @default(now())
  verified    Boolean  @default(false) // QR code verified

  @@unique([userId, eventId])
  @@index([userId])
  @@index([eventId])
}

// Personalization & Community models

model User {
  id          String              @id @default(uuid())
  email       String              @unique
  name        String?
  avatar      String?
  onboarded   Boolean             @default(false)
  defaultCity String?
  interests   String[]            @default([])
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  profile     UserProfile?
  favorites   Favorite[]
  reminders   Reminder[]
  itineraries Itinerary[]
  lists       CollaborativeList[]
  photos      Photo[]

  @@index([email])
  @@index([onboarded])
}

model UserProfile {
  id                 String   @id @default(uuid())
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId             String   @unique
  savedFilters       Json? // Saved filter configurations
  preferences        Json? // User preferences (accessibility, family, etc.)
  followedVenues     String[] @default([])
  followedCategories String[] @default([])
  followedCities     String[] @default([])
  updatedAt          DateTime @updatedAt

  @@index([userId])
}

model Favorite {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId   String
  createdAt DateTime @default(now())

  @@unique([userId, eventId])
  @@index([userId])
  @@index([eventId])
}

model Reminder {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  event        Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId      String
  type         String // "email", "push", "sms"
  scheduledFor DateTime
  sent         Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([userId])
  @@index([eventId])
  @@index([scheduledFor, sent])
}

model Itinerary {
  id        String   @id @default(uuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  name      String
  eventIds  String[]
  optimized Json? // Optimized route data
  public    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([public])
}

model CollaborativeList {
  id          String     @id @default(uuid())
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  title       String
  description String?
  public      Boolean    @default(false)
  items       ListItem[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([userId])
  @@index([public])
}

model ListItem {
  id        String            @id @default(uuid())
  list      CollaborativeList @relation(fields: [listId], references: [id], onDelete: Cascade)
  listId    String
  event     Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId   String
  order     Int               @default(0)
  createdAt DateTime          @default(now())

  @@unique([listId, eventId])
  @@index([listId])
  @@index([eventId])
}

model Photo {
  id        String   @id @default(uuid())
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId   String
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId    String?
  imageUrl  String
  moderated Boolean  @default(false)
  approved  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([eventId])
  @@index([userId])
  @@index([moderated, approved])
}

model EventSimilarity {
  id             String   @id @default(uuid())
  event          Event    @relation("EventToSimilar", fields: [eventId], references: [id], onDelete: Cascade)
  eventId        String
  similarEvent   Event    @relation("SimilarToEvent", fields: [similarEventId], references: [id], onDelete: Cascade)
  similarEventId String
  score          Float // 0-100 similarity score
  createdAt      DateTime @default(now())

  @@unique([eventId, similarEventId])
  @@index([eventId])
  @@index([similarEventId])
  @@index([score])
}

model SiteSettings {
  id         String   @id @default(uuid())
  siteName   String   @default("Territoire en Fête")
  slogan     String   @default("Tout ce qui bouge près de chez vous.")
  logoUrl    String?
  faviconUrl String?
  updatedAt  DateTime @updatedAt
  createdAt  DateTime @default(now())
}
